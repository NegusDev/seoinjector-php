{
    "name": "negusdev/seoinjector-php",
    "description": "Universal PHP library for SEO Injector - Works with Laravel, WordPress, Symfony, or any PHP project",
    "type": "library",
    "keywords": [
        "seo",
        "metadata",
        "php",
        "laravel",
        "wordpress",
        "symfony",
        "open-graph",
        "twitter-cards",
        "meta-tags"
    ],
    "homepage": "https://seoinjector.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Enoch",
            "email": "enochnegus@gmail.com",
            "homepage": "https://docs.seoinjector.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^12.50"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel integration (^9.0|^10.0|^11.0|^12.0)"
    },
    "autoload": {
        "psr-4": {
            "SEOInjector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SEOInjector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse src --level=8",
        "format": "phpcbf src tests",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
